        (is_glitched and can_jumpslash)",
            "Shadow Temple Boat Area Balcony": "glitch_shadow_boat_skull and (
                    (Child_Shadow and can_take_damage and has_bombchus) or
                    (is_adult and can_take_damage and has_bombchus) or
                    (is_adult and glitch_shadow_boat_skull_adult_nothing and can_shield)
